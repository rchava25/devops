# YOUR CURRENT inflate (problematic)
containers:
- name: pause
  image: public.ecr.aws/eks-distro/kubernetes/pause:3.7
  resources: {}          # ← NO requests set
                         # Karpenter sees 0 CPU, 0 memory needed
                         # provisions the SMALLEST possible node
                         # real workload arrives → node is too small

# CORRECT inflate (what it should be)
containers:
- name: pause
  image: public.ecr.aws/eks-distro/kubernetes/pause:3.7
  resources:
    requests:
      cpu: "1"           # ← match your real workload pod size
      memory: "1Gi"      # ← Karpenter provisions a node big enough
priorityClassName: low-priority   # ← evicted first when real pod arrives

