Run in CloudShell
6. Fix inflate — apply correct requests and priority
# Step 1 — Create low-priority class
kubectl apply -f - <<EOF
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: low-priority
value: -1
globalDefault: false
description: "inflate over-provisioning pods — evicted first by real workloads"
EOF

# Step 2 — Patch inflate with correct requests and priority
kubectl patch deployment inflate -n default --type=merge -p '{
  "spec": {
    "template": {
      "spec": {
        "priorityClassName": "low-priority",
        "containers": [{
          "name": "pause",
          "resources": {
            "requests": {
              "cpu": "1",
              "memory": "1Gi"
            }
          }
        }]
      }
    }
  }
}'

# Step 3 — Verify the patch applied
kubectl get deployment inflate -n default \
  -o jsonpath='{.spec.template.spec.containers[0].resources}'
# {"requests":{"cpu":"1","memory":"1Gi"}}

# Step 4 — Watch pods restart with new requests
kubectl rollout status deployment/inflate -n default
kubectl get pods -n default -o wide

