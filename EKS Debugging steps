Level 4 — Network debugging
# ── STEP 1: Is CoreDNS healthy? ──────────────────────────────────────────────
kubectl get pods -n kube-system -l k8s-app=kube-dns
kubectl logs -n kube-system -l k8s-app=kube-dns --tail=50

# ── STEP 2: DNS resolution test from inside a pod ────────────────────────────
kubectl run dns-test --image=busybox:1.28 --restart=Never -it --rm \
  -- nslookup kubernetes.default
# Expected: Server: 172.20.0.10  Address: kubernetes.default.svc.cluster.local

# ── STEP 3: Can pod A reach pod B? ───────────────────────────────────────────
# Get pod B's IP
kubectl get pod <pod-b> -n <namespace> -o jsonpath='{.status.podIP}'

# Shell into pod A and curl pod B
kubectl exec -it <pod-a> -n <namespace> -- curl http://<pod-b-ip>:<port>

# ── STEP 4: Is a Service routing correctly? ──────────────────────────────────
kubectl get svc -n <namespace>
kubectl describe svc <service-name> -n <namespace>
# Look for: Endpoints — if empty, label selector doesn't match any pods

kubectl get endpoints <service-name> -n <namespace>
# Empty endpoints = selector mismatch or no Ready pods

# ── STEP 5: Is vpc-cni healthy? (node groups) ────────────────────────────────
kubectl get pods -n kube-system -l k8s-app=aws-node
kubectl logs -n kube-system -l k8s-app=aws-node --tail=50 | grep -E "ERROR|WARN|failed"

# ── STEP 6: Network policy blocking traffic? ─────────────────────────────────
kubectl get networkpolicy -A
kubectl describe networkpolicy <name> -n <namespace>

# ── STEP 7: Test connectivity with a temporary pod ───────────────────────────
kubectl run nettest --image=nicolaka/netshoot --restart=Never -it --rm \
  -- curl -v http://<service-name>.<namespace>.svc.cluster.local:<port>

