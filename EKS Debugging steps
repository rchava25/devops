Level 6 — Storage debugging
# ── STEP 1: PVC not binding? ─────────────────────────────────────────────────
kubectl get pvc -A
# STATUS=Pending → StorageClass issue or no available PV

kubectl describe pvc <pvc-name> -n <namespace>
# Look for: ProvisioningFailed, no persistent volumes available

# ── STEP 2: StorageClass configured? ─────────────────────────────────────────
kubectl get storageclass
# For Auto Mode: should see gp2 or gp3 as default

# ── STEP 3: EBS CSI driver healthy? ──────────────────────────────────────────
kubectl get pods -n kube-system -l app=ebs-csi-controller
kubectl logs -n kube-system -l app=ebs-csi-controller -c ebs-plugin --tail=50

# ── STEP 4: Volume attachment events ─────────────────────────────────────────
kubectl get events -A \
  --field-selector reason=FailedAttachVolume \
  --sort-by='.lastTimestamp'

