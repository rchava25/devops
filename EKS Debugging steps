Level 7 — inflate-specific debugging (your cluster)
# ── STEP 1: Check inflate has no resource requests (confirmed issue) ──────────
kubectl get deployment inflate -n default \
  -o jsonpath='{.spec.template.spec.containers[0].resources}'
# Current output: {}  ← fix this first

# ── STEP 2: Check inflate has no PriorityClass (confirmed issue) ──────────────
kubectl get deployment inflate -n default \
  -o jsonpath='{.spec.template.spec.priorityClassName}'
# Current output: (empty)  ← fix this second

# ── STEP 3: Apply the fix ─────────────────────────────────────────────────────
# Create low-priority class
kubectl apply -f - <<EOF
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: low-priority
value: -1
globalDefault: false
description: "inflate over-provisioning pods — evicted first"
EOF

# Patch inflate with correct requests + priority
kubectl patch deployment inflate -n default --type=merge -p '{
  "spec": {"template": {"spec": {
    "priorityClassName": "low-priority",
    "containers": [{"name": "pause", "resources": {
      "requests": {"cpu": "1", "memory": "1Gi"}
    }}]
  }}}
}'

# ── STEP 4: Verify Karpenter reacts ──────────────────────────────────────────
kubectl rollout status deployment/inflate -n default
kubectl get nodeclaims -w
kubectl logs -n kube-system -l app.kubernetes.io/name=karpenter \
  --since=2m | grep -E "provisioned|consolidat|inflate"

