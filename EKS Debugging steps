Level 3 — Deployment / ReplicaSet debugging
# ── STEP 1: Deployment rollout status ────────────────────────────────────────
kubectl rollout status deployment/<name> -n <namespace>
# Stuck here = pods not becoming Ready

# ── STEP 2: Deployment history ───────────────────────────────────────────────
kubectl rollout history deployment/<name> -n <namespace>

# ── STEP 3: Rollback to previous version ─────────────────────────────────────
kubectl rollout undo deployment/<name> -n <namespace>

# ── STEP 4: ReplicaSet — why aren't replicas coming up? ──────────────────────
kubectl get replicaset -n <namespace>
kubectl describe replicaset <rs-name> -n <namespace>
# Look for: FailedCreate events — quota exceeded, image pull errors

# ── STEP 5: Events for a deployment ──────────────────────────────────────────
kubectl get events -n <namespace> \
  --field-selector involvedObject.name=<deployment-name> \
  --sort-by='.lastTimestamp'

# ── STEP 6: All recent warning events cluster-wide ───────────────────────────
kubectl get events -A \
  --field-selector type=Warning \
  --sort-by='.lastTimestamp' | tail -30

