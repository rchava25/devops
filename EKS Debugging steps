Level 5 — IAM / RBAC debugging
# ── STEP 1: Can I perform an action? (dry-run auth check) ────────────────────
kubectl auth can-i get pods -n default
kubectl auth can-i get pods -n default --as system:serviceaccount:default:my-sa

# ── STEP 2: What can a service account do? ───────────────────────────────────
kubectl auth can-i --list --as system:serviceaccount:<namespace>:<sa-name>

# ── STEP 3: Who has access to what? ──────────────────────────────────────────
kubectl get rolebindings,clusterrolebindings -A \
  -o json | jq -r '
  .items[] |
  .metadata.name + " → " +
  (.subjects // [] | map(.name) | join(", "))'

# ── STEP 4: EKS access entries ───────────────────────────────────────────────
aws eks list-access-entries --cluster-name eks --region us-east-1
aws eks describe-access-entry \
  --cluster-name eks \
  --principal-arn <role-arn> \
  --region us-east-1

# ── STEP 5: IRSA — is the service account annotated? ─────────────────────────
kubectl get serviceaccount <sa-name> -n <namespace> -o yaml
# Look for: eks.amazonaws.com/role-arn annotation

# ── STEP 6: Check IAM policies on node role ───────────────────────────────────
aws iam list-attached-role-policies \
  --role-name AmazonEKSAutoNodeRole \
  --region us-east-1

