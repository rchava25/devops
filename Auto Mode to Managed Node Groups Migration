Phase 4 — Migrate workloads to node groups
At this point both Auto Mode nodes and node group nodes are running. Drain Auto Mode nodes gracefully to move workloads:

# Step 1 — Identify Auto Mode nodes (managed by Karpenter/NodeClaims)
kubectl get nodes -l eks.amazonaws.com/compute-type=auto

# Step 2 — Cordon Auto Mode nodes (stop new pods scheduling on them)
for node in $(kubectl get nodes -l eks.amazonaws.com/compute-type=auto -o name); do
  kubectl cordon $node
done

# Step 3 — Verify workloads are scheduling on node group nodes
kubectl get pods -A -o wide | grep -v "eks.amazonaws.com/compute-type=auto"

# Step 4 — Drain Auto Mode nodes one at a time
for node in $(kubectl get nodes -l eks.amazonaws.com/compute-type=auto -o jsonpath='{.items[*].metadata.name}'); do
  kubectl drain $node \
    --ignore-daemonsets \
    --delete-emptydir-data \
    --grace-period=60 \
    --timeout=300s
  echo "Drained $node — waiting 30s before next node"
  sleep 30
done

# Step 5 — Confirm all pods are Running on node group nodes
kubectl get pods -A -o wide
kubectl get nodes

