Phase 2 — Create managed node groups
Your cluster has 2 subnets. Create one node group per subnet now, and add a third AZ subnet when available:

# Node group for subnet-03da6ad4ced808a19
aws eks create-nodegroup \
  --cluster-name eks \
  --nodegroup-name prod-ng-1 \
  --node-role arn:aws:iam::827841612288:role/AmazonEKSNodeRole \
  --subnets subnet-03da6ad4ced808a19 subnet-001af177100973cfd \
  --instance-types m5.xlarge m5a.xlarge \
  --ami-type AL2_x86_64 \
  --capacity-type ON_DEMAND \
  --scaling-config minSize=2,maxSize=10,desiredSize=3 \
  --update-config maxUnavailablePercentage=33 \
  --labels role=general-purpose \
  --region us-east-1

# Watch node group creation (takes ~3-5 minutes)
aws eks describe-nodegroup \
  --cluster-name eks \
  --nodegroup-name prod-ng-1 \
  --query 'nodegroup.status' \
  --region us-east-1

