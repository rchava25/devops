Phase 3 — Install addons required by node groups
Your cluster already has coredns and kube-proxy. You need to add vpc-cni and aws-ebs-csi-driver — these were handled by Auto Mode before:

# Install vpc-cni (REQUIRED — this is the CNI for node groups)
aws eks create-addon \
  --cluster-name eks \
  --addon-name vpc-cni \
  --resolve-conflicts OVERWRITE \
  --region us-east-1

# Install aws-ebs-csi-driver (REQUIRED for PersistentVolumes)
# First create the IRSA role for it
eksctl create iamserviceaccount \
  --cluster eks \
  --namespace kube-system \
  --name ebs-csi-controller-sa \
  --attach-policy-arn arn:aws:iam::aws:policy/service-role/AmazonEBSCSIDriverPolicy \
  --approve \
  --region us-east-1

# Then install the addon
aws eks create-addon \
  --cluster-name eks \
  --addon-name aws-ebs-csi-driver \
  --resolve-conflicts OVERWRITE \
  --region us-east-1

# Verify both addons are ACTIVE
aws eks list-addons --cluster-name eks --region us-east-1
aws eks describe-addon --cluster-name eks --addon-name vpc-cni \
  --query 'addon.status' --region us-east-1
aws eks describe-addon --cluster-name eks --addon-name aws-ebs-csi-driver \
  --query 'addon.status' --region us-east-1

