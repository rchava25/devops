Diagnostic Commands — Run in Order
# Step 1 — Check pod status
kubectl get pods -A
# Look for: any pods in Pending or ContainerCreating for more than 2 minutes

# Step 2 — Describe a stuck pod
kubectl describe pod <pod-name> -n <namespace>
# Look for: FailedCreatePodSandBox or FailedScheduling in the Events section

# Step 3 — Check IAM policies on the cluster role
aws iam list-attached-role-policies --role-name AmazonEKSClusterRole
# Look for: AmazonEKSClusterPolicy, AmazonEKSComputePolicy,
#           AmazonEKSNetworkingPolicy, AmazonEKSBlockStoragePolicy

# Step 4 — Check for stale access entries
aws eks list-access-entries --cluster-name <cluster>
# Look for: any entry containing AmazonEKSAutoNodeRole1 (trailing 1) — should not exist

# Step 5 — Check installed addons
aws eks list-addons --cluster-name <cluster>
# Look for: vpc-cni should NOT be present on Auto Mode clusters

# Step 6 — Check IPAM errors in CloudTrail
aws cloudtrail lookup-events \
  --lookup-attributes AttributeKey=EventName,AttributeValue=AssignPrivateIpAddresses \
  --max-results 5
# Look for: 403 UnauthorizedOperation errors from eks-auto-mode-ipam-* principal

Run in CloudShell
Fix Steps
Fix 1 — Attach AmazonEKSNetworkingPolicy (Root Cause)
Required for: EKS Auto Mode clusters. The IPAM controller runs as AmazonEKSClusterRole and needs ec2:AssignPrivateIpAddresses to assign pod IPs.

# Step 1 — Attach AmazonEKSNetworkingPolicy
aws iam attach-role-policy \
  --role-name AmazonEKSClusterRole \
  --policy-arn arn:aws:iam::aws:policy/AmazonEKSNetworkingPolicy

# Step 2 — Attach AmazonEKSBlockStoragePolicy (also required)
aws iam attach-role-policy \
  --role-name AmazonEKSClusterRole \
  --policy-arn arn:aws:iam::aws:policy/AmazonEKSBlockStoragePolicy

# Step 3 — Verify all 4 policies are attached
aws iam list-attached-role-policies --role-name AmazonEKSClusterRole

# Step 4 — Wait 60–90 seconds for IPAM controller session to refresh
# (IAM credential propagation delay — this is expected, do not re-apply the fix)

# Step 5 — Confirm IPAM is now succeeding (look for events with no errorCode)
aws cloudtrail lookup-events \
  --lookup-attributes AttributeKey=EventName,AttributeValue=AssignPrivateIpAddresses \
  --max-results 5

Run in CloudShell
Fix 2 — Remove Stale Access Entry
Required for: Any cluster where AmazonEKSAutoNodeRole1 (note the trailing 1) appears as an access entry. This stale entry blocks new Auto Mode nodes from registering.

# Step 1 — List all access entries to find the stale one
aws eks list-access-entries --cluster-name <cluster>

# Step 2 — Delete the stale AmazonEKSAutoNodeRole1 entry
aws eks delete-access-entry \
  --cluster-name <cluster> \
  --principal-arn arn:aws:iam::<account-id>:role/AmazonEKSAutoNodeRole1

# Step 3 — Verify only valid entries remain
# (should have AmazonEKSAutoNodeRole without the trailing 1)
aws eks list-access-entries --cluster-name <cluster>

Run in CloudShell
Fix 3 — Remove vpc-cni Addon
Required for: EKS Auto Mode clusters. Auto Mode has a built-in CNI — the vpc-cni addon is incompatible and leaves a stale aws-cni binary on nodes that blocks pod sandbox creation.

# Step 1 — Delete the vpc-cni addon
aws eks delete-addon --cluster-name <cluster> --addon-name vpc-cni

# Step 2 — Verify addon is removed
aws eks list-addons --cluster-name <cluster>

# Step 3 — Recycle nodes to remove stale aws-cni binary from node filesystem
kubectl delete nodeclaim --all

# Step 4 — Delete pending pods so they reschedule on clean nodes
kubectl delete pods -A --field-selector=status.phase=Pending

# Step 5 — Watch new pods come up
kubectl get pods -A -w

